# ─────────────────────────────────────────────────────────────────
# TEST-ARCHON — Environment variables
# Copy to .env and fill in your values before running the backend.
# ─────────────────────────────────────────────────────────────────

# ── IBM watsonx.ai / Bob LLM ─────────────────────────────────────
IBM_API_KEY=your_ibm_cloud_api_key_here
IBM_PROJECT_ID=your_watsonx_project_id_here
IBM_MODEL_ID=meta-llama/llama-3-3-70b-instruct
IBM_BASE_URL=https://us-south.ml.cloud.ibm.com

# ── GitHub (only required when use_github=true in /api/v1/run) ───
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=owner/repo

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
